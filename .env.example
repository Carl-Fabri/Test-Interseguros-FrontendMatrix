# ─── matrix-web · variables de entorno (solo para Docker) ────────────────────
# Copia este archivo a .env. Al arrancar el contenedor se genera /config.json con estos valores.
# IMPORTANTE: son URLs que usa el NAVEGADOR del usuario, no la red interna de Docker.
# No pongas secretos aquí: todo lo que recibe el frontend es público.

# URL pública de api-go (login y factorización QR)
API_GO_URL=http://localhost:8080
# URL pública de api-node (estadísticas)
API_NODE_URL=http://localhost:3000
# Intervalo de sondeo de /health en milisegundos
HEALTH_POLL_MS=15000

# Puerto del host donde se publica el frontend. Debe coincidir con CORS_ALLOWED_ORIGINS de ambas APIs.
WEB_PORT=4200
